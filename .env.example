# Local lab configuration only. Do not commit real secrets or target inventories.

# Bind addresses — keep development on loopback.
NMAP_AI_HOST=127.0.0.1
NMAP_AI_PORT=8000
NMAP_AI_FRONTEND_ORIGIN=http://127.0.0.1:5173

# Set unique local credentials before exposing the API beyond loopback.
NMAP_AI_API_TOKEN=replace-with-a-long-random-token
NMAP_AI_USERNAME=lab
NMAP_AI_PASSWORD=change-me

# Database
NMAP_AI_DATABASE_URL=sqlite:///data/nmap_ai.db

# Scanner
NMAP_AI_NMAP_PATH=nmap
NMAP_AI_SCAN_TIMEOUT_SECONDS=600

# Lab identities (leave empty until configured)
NMAP_AI_SCANNER_NAME=
NMAP_AI_SCANNER_IP=
NMAP_AI_TARGET_NAME=
NMAP_AI_TARGET_IP=
NMAP_AI_AUTHORIZED_TARGETS=

# Optional external telemetry listener
NMAP_AI_INGEST_HOST=127.0.0.1
NMAP_AI_INGEST_PORT=9999

# Logging
NMAP_AI_LOG_LEVEL=INFO
